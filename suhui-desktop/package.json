{
  "name": "suhui-desktop",
  "version": "1.0.26102",
  "description": "溯洄桌面版 - 个人本地日记应用（Electron + Vue 3 + SQLite）",
  "main": "./out/main/index.js",
  "author": "wgz",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test:dao": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dao-smoke.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "pack:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.wgz.suhui",
    "productName": "溯洄桌面版",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "溯洄桌面版",
      "artifactName": "suhui-setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "docx": "^9.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pinia": "^2.2.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.12"
  }
}
